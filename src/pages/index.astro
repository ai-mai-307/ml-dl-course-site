---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const base = import.meta.env.BASE_URL;
---

<StarlightPage
  frontmatter={{
    title: 'Машинное и глубокое обучение',
    description: 'Учебник, курсы и практические инструкции по ML и DL.',
    template: 'splash',
  }}
>
  <p>Новая версия сайта готовится к открытию.</p>
  <ul>
    <li><a href={`${base}textbook/`}>Учебник</a> — теория машинного и глубокого обучения.</li>
    <li><a href={`${base}courses/`}>Курсы</a> — программы, задания и материалы занятий.</li>
    <li><a href={`${base}guides/`}>Инструкции</a> — помощь в практической работе.</li>
  </ul>
</StarlightPage>
