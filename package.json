{
  "name": "ml-dl-course-site",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:content": "astro sync",
    "check:links": "node --experimental-strip-types scripts/check-links.mjs",
    "test": "node --experimental-strip-types --test tests/authoring.test.mjs tests/courses.test.mjs tests/course-build.test.mjs tests/drafts.test.mjs tests/youtube.test.mjs tests/youtube-browser.test.mjs tests/legacy-routes.test.mjs",
    "check:authoring": "node --experimental-strip-types --test tests/built-authoring.test.mjs tests/built-textbook.test.mjs tests/built-guides.test.mjs tests/built-courses.test.mjs tests/built-site.test.mjs tests/built-redirects.test.mjs",
    "validate": "npm test && npm run check && npm run build && npm run check:links && npm run check:authoring",
    "astro": "astro",
    "check:browser": "node --experimental-strip-types scripts/check-browser.mjs",
    "check:legacy-routes": "node --experimental-strip-types scripts/check-legacy-routes.mjs",
    "check:artifact": "node --experimental-strip-types scripts/check-artifact.mjs",
    "preview:artifact": "node --experimental-strip-types scripts/serve-artifact.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/starlight": "0.42.4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "astro": "7.3.5",
    "katex": "0.19.0",
    "satteri": "0.10.5",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "parse5": "8.0.1",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
