---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { isVisible } from '../../utils/publishing';

const notes = (await getCollection('notes', (entry) => isVisible(entry, import.meta.env.DEV)))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() || a.id.localeCompare(b.id));
---

<StarlightPage frontmatter={{ title: 'Заметки', description: 'Авторские статьи и короткие заметки.' }}>
  {notes.length === 0 && <p>Заметок пока нет.</p>}
  <ul>
    {notes.map((note) => (
      <li>
        <a href={`${import.meta.env.BASE_URL}notes/${note.id.split('/').map(encodeURIComponent).join('/')}/`}>{note.data.title}</a>
        {note.data.draft && <small> — черновик</small>}
        <p>{note.data.description}</p>
      </li>
    ))}
  </ul>
</StarlightPage>
