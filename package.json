{
  "name": "ml-dl-course-site",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:content": "astro sync",
    "check:links": "node --experimental-strip-types scripts/check-links.mjs",
    "test": "node --experimental-strip-types --test tests/authoring.test.mjs",
    "check:authoring": "node --experimental-strip-types --test tests/built-authoring.test.mjs",
    "validate": "npm test && npm run check && npm run build && npm run check:links && npm run check:authoring",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/starlight": "0.42.4",
    "astro": "7.3.5",
    "katex": "0.19.0",
    "satteri": "0.10.5",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "parse5": "8.0.1",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
